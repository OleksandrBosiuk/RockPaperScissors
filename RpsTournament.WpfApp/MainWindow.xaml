<Window x:Class="RpsTournament.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kivi-Paber-Käärid Turniir" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Mängija nimi:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox x:Name="PlayerNameTextBox" Width="180" Height="26" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Vali käik:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <ComboBox x:Name="PlayerMoveComboBox" Width="120" Height="26" Margin="0,0,15,0" VerticalContentAlignment="Center"/>
            <Button x:Name="PlayRoundButton" Content="Mängi voor" Width="100" Height="26" Margin="0,0,10,0" Click="PlayRoundButton_Click"/>
            <Button x:Name="NewTournamentButton" Content="Uus turniir" Width="100" Height="26" Click="NewTournamentButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="RoundsDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Voor" Binding="{Binding Number}" Width="60"/>
                <DataGridTextColumn Header="Mängija käik" Binding="{Binding PlayerMove}" Width="*"/>
                <DataGridTextColumn Header="Arvuti käik" Binding="{Binding ComputerMove}" Width="*"/>
                <DataGridTextColumn Header="Tulemus" Binding="{Binding Result}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ScoreTextBlock" Grid.Row="3" Text="Skoor: Võite: 0 | Kaotusi: 0 | Viike: 0" 
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
        
        
        <TextBlock x:Name="StatusTextBlock" Grid.Row="4" Text="" Foreground="Red" Margin="0,0,0,5"/>
    </Grid>
</Window>
